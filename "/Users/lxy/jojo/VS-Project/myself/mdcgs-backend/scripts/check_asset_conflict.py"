async def get_occupied_assets(
    _: SysUser = Depends(PermissionChecker("task_view")),
    db: Session = Depends(get_db),
):
    """获取所有已被任务占用的资产 ID → 任务名映射"""
    tasks = db.query(ClassificationTask).all()
    result: dict[str, str] = {}
    for t in tasks:
        for aid in (t.asset_ids or []):
            result[str(aid)] = t.name
    return success(result)


