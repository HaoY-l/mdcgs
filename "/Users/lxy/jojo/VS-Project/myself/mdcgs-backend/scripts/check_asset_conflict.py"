async def create_task(
    request: Request,
    body: ClassificationTaskCreate,
    _: SysUser = Depends(PermissionChecker("task_create")),
    db: Session = Depends(get_db),
    current_user = Depends(get_current_user),
):
    """创建分类任务"""
    # 检查资产是否已被其他任务占用
    conflicted = _check_asset_conflict(body.asset_ids, exclude_task_id=None, db=db)
    if conflicted:
        names = [c["task_name"] for c in conflicted]
        return error(f"以下资产已被任务「{'、'.join(names)}」占用，请先移除")

    task = ClassificationTask(
        name=body.name,
