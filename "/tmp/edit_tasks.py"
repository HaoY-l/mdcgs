#!/usr/bin/env python3
import re

path = "/Users/lxy/jojo/VS-Project/myself/mdcgs-backend/app/api/v1/classification/tasks.py"
with open(path) as f:
    content = f.read()

old_start = '@task_router.post("/classification-tasks/{task_id}/start")\nasync def start_task(\n    request: Request,\n    task_id: int = Path(...),\n    _: SysUser = Depends(PermissionChecker("scan_execute")),'

new_section = '@task_router.get("/classification-tasks/occupied-assets")\nasync def get_occupied_assets(\n    _: SysUser = Depends(PermissionChecker("task_view")),\n    db: Session = Depends(get_db),\n):\n    """获取所有已被任务占用的资产 ID → 任务名映射"""\n    tasks = db.query(ClassificationTask).all()\n    result: dict[str, str] = {}\n    for t in tasks:\n        for aid in (t.asset_ids or []):\n            result[str(aid)] = t.name\n    return success(result)\n\n\n' + old_start

if old_start in content:
    content = content.replace(old_start, new_section, 1)
    print("✅ occupied-assets 接口已添加")
else:
    print("⚠️  start_task 块未匹配")
    idx = content.find("start_task")
    if idx > 0:
        print(repr(content[idx-30:idx+150]))

with open(path, "w") as f:
    f.write(content)

print(f"✅ 写入完成: {path}")